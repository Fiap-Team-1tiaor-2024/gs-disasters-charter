# Variáveis de ambiente — Disasters Charter
# Copie para .env e ajuste os valores conforme necessário

# Caminho para o arquivo CSV do INMET ( dataset principal )
DATA_PATH=./data/inmet_sp.csv

# Caminho para o arquivo JSON do sensor ESP32 simulado
ESP32_DATA_PATH=./data/esp32_simulado.json

# Caminho para a pasta de imagens de satélite
IMAGES_PATH=./assets/imagens

# Caminho para salvar outputs gerados ( mapas, relatórios, gráficos )
OUTPUTS_PATH=./outputs_gerados